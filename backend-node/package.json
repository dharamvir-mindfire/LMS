{
  "name": "lms-backend",
  "version": "1.0.0",
  "description": "LMS backend API",
  "main": "../build/backend-node/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node ../build/backend-node/server.js",
    "dev": "tsx watch src/server.ts",
    "seed:users": "tsx src/seeders/UserSeeder.ts",
    "seed:questions": "tsx src/seeders/QuestionSeeder.ts",
    "seed": "npm run seed:users && npm run seed:questions"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
